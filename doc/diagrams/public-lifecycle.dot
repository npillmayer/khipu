// Regenerate: dot -Tsvg doc/diagrams/public-lifecycle.dot -o doc/diagrams/public-lifecycle.svg
digraph PublicLifecycle {
 graph [rankdir=TB, bgcolor="white", pad=0.25, nodesep=0.4, ranksep=0.5, fontname="Helvetica"];
 node [shape=box, style="rounded,filled", fillcolor="#f1f5f9", color="#94a3b8", fontcolor="#172b4d", fontname="Helvetica", fontsize=12, margin="0.18,0.12"];
 edge [color="#64748b", arrowsize=0.7];
 source [label="Styled paragraph + optional atomic anchors"];
 prepare [label="PrepareParagraph / EncodeParagraph", fillcolor="#e0f2fe"];
 material [label="Immutable SoA Khipu\nSource, knots, glyphs, incarnation"];
 discovery [label="Discovery\nFixed recipe + complete immutable batches"];
 measure [label="MeasureIntrinsic\nRepeat with new atomic ranges"];
 binding [label="AtomicBinding\nShared base + copied advances"];
 geometry [label="Trial geometry + breaker policy", fillcolor="#fef3c7"];
 trial [label="First-fit / KP\nPrivate search workspace", fillcolor="#e0f2fe"];
 plan [label="Immutable Tikray\nDecisions, captured widths/skips, policy"];
 checkpoint [label="Checkpoint\nCopied accepted prefix"];
 freeze [label="Freeze(plan)\nNo discovery or shape callback", fillcolor="#e0f2fe"];
 frozen [label="FrozenKhipu\nIndependent retained horizontal output", fillcolor="#dcfce7"];
 source -> prepare;
 prepare -> material;
 prepare -> discovery;
 material -> measure;
 discovery -> measure;
 material -> binding [label="BindParagraph"];
 binding -> trial;
 discovery -> trial;
 geometry -> trial;
 trial -> plan;
 plan -> checkpoint;
 checkpoint -> trial [label="First-fit continuation\nNoHyphenation"];
 plan -> freeze;
 freeze -> frozen;
}
